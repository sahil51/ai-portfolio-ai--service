# Database Configuration (PostgreSQL / Supabase)
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_HOST=127.0.0.1
DB_PORT=5432
JWT_SECRET=your_jwt_secret_key

# AI Agent Configuration (Multi-Tier LLM: Cerebras -> Gemini -> NVIDIA)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001

CEREBRAS_API_KEY=your_cerebras_api_key
CEREBRAS_MODEL=gpt-oss-120b
CEREBRAS_CHAT_URL=https://api.cerebras.ai/v1/chat/completions

NVIDIA_API_KEY=your_nvidia_api_key
NVIDIA_MODEL=mistralai/mistral-nemotron
NVIDIA_CHAT_URL=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_BACKUP_MODELS=nvidia/llama-3.1-nemotron-70b-instruct,meta/llama-3.1-70b-instruct,meta/llama-3.1-8b-instruct

# AI Assistant API URL (FastAPI microservice)
CHAT_API_PORT=8001
CHAT_API_URL=http://127.0.0.1:8001/api/chat
REINDEX_WEBHOOK_URL=http://127.0.0.1:8001/api/reindex

# n8n Workflow Webhook
N8N_MEETING_WEBHOOK_URL=https://your-n8n-instance.com/webhook/your-webhook-id

# LangSmith Tracing & Observability
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_PROJECT=portfolio-assistant

# Security & Token Protection Config
INTERNAL_API_KEY=your_internal_api_key
MAX_MESSAGE_LENGTH=350
MAX_SESSION_MESSAGES=20
MAX_IP_REQUESTS_PER_MIN=10

# Email SMTP Configuration (Gmail / Custom SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
DEFAULT_FROM_EMAIL=your_email@gmail.com
NOTIFICATION_EMAIL=your_email@gmail.com
